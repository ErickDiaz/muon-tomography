# =============================================================================
# .env.example — Plantilla de variables de entorno para deploy al servidor.
#
# Uso:
#   1. Copiar: cp .env.example .env
#   2. Llenar los valores reales del servidor
#   3. NUNCA versionar .env en git (ya esta en .gitignore)
#
# IMPORTANTE: NO uses comentarios en linea (ej. VAR=valor   # comentario).
# Make los interpreta como parte del valor. Pon los comentarios SIEMPRE
# en su propia linea, arriba de la variable.
# =============================================================================

# -----------------------------------------------------------------------------
# Acceso SSH al servidor dedicado (Debian)
# -----------------------------------------------------------------------------

# IP o hostname del servidor
SERVER_HOST=192.168.30.70

# Usuario SSH en el servidor
SERVER_USER=jarjarbinks

# Puerto SSH (default 22)
SERVER_PORT=22

# Ruta a la llave privada SSH (usar ~ para HOME)
SERVER_SSH_KEY=~/.ssh/id_ed25519

# -----------------------------------------------------------------------------
# Rutas remotas en el servidor
# -----------------------------------------------------------------------------

# Directorio raiz del proyecto en el servidor. rsync sincroniza aqui.
SERVER_PROJECT_DIR=/home/jarjarbinks/thesis

# DEMs, ERA5 (puede apuntar a un disco mas grande)
SERVER_DATA_DIR=/home/jarjarbinks/thesis/data

# Outputs CORSIKA (decenas de GB en produccion)
SERVER_OUTPUT_DIR=/home/jarjarbinks/thesis/sim/output

# -----------------------------------------------------------------------------
# Hardware del servidor
# -----------------------------------------------------------------------------

# true si el servidor tiene NVIDIA GPU (controla si server-setup.sh instala el toolkit)
SERVER_HAS_GPU=false

# -----------------------------------------------------------------------------
# CORSIKA / imagenes Docker
# -----------------------------------------------------------------------------

# Version del tarball (corsika-${VER}.tar.gz)
CORSIKA_VERSION=78050

# Modelo hadronico de alta energia (ver docker/coconut.expect)
# 1=DPMJET-III (2017.1) + PHOJET, 2=EPOS.LHC-R, 3=QGSJETIII-01, 4=SIBYLL 2.3e
HE_MODEL=1

# Tag de las imagenes Docker
IMAGE_TAG=latest

# Registry Docker (opcional). Si vacio, se usa transferencia via tar+scp.
# Ejemplos: ghcr.io/tu-usuario  |  docker.io/tu-usuario
DOCKER_REGISTRY=

# -----------------------------------------------------------------------------
# Estrategia de deploy
# -----------------------------------------------------------------------------
# Como llegar la imagen al servidor:
#   build  -> rsync repo + tarball al servidor, construir alla (recomendado)
#   load   -> construir local, exportar a tar, scp, docker load
#   pull   -> push al registry desde local, pull en el servidor (requiere REGISTRY)
DEPLOY_STRATEGY=build
