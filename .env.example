# =============================================================================
# .env.example — Plantilla opcional de overrides.
#
# Uso:
#   - Solo si querés cambiar los defaults: cp .env.example .env
#   - .env esta en .gitignore (nunca se versiona)
#
# El Makefile tiene defaults sensatos para las 3 variables de abajo, asi que
# .env es opcional: el repo funciona sin tener .env creado.
#
# IMPORTANTE: NO uses comentarios en linea (VAR=valor   # comentario). Make
# los interpreta como parte del valor. Poné los comentarios en su propia
# linea, arriba de la variable.
# =============================================================================

# Version del tarball CORSIKA (archivo corsika-${CORSIKA_VERSION}.tar.gz en la raiz)
# Default: 78050
CORSIKA_VERSION=78050

# Modelo hadronico de alta energia (ver docker/coconut.expect):
#   1 = DPMJET-III + PHOJET (default, calibrado con LHC)
#   2 = EPOS-LHC-R
#   3 = QGSJETIII-01
#   4 = SIBYLL 2.3e
HE_MODEL=1

# Tag de las imagenes Docker.
# Default: latest
IMAGE_TAG=latest
