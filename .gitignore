# Salida de CORSIKA — pueden pesar decenas de GB
sim/output/
sim/atmosphere/

# Steering generado por `make corsika-run` (template + sed)
sim/steering/fuego_run.inp

# Logs de corridas en servidor (rsync-generated)
logs/

# Archivos comprimidos del código CORSIKA
*.tar.gz
*.tar.bz2

# Binarios compilados
*.o
*.a
corsika-78050/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/                       # Poetry in-project venv (regenerable con `make install`)

# Variables de entorno (credenciales del servidor)
.env
.env.local
.env.*.local

# Imagenes Docker exportadas
thesis-corsika-*.tar.gz
thesis-ml-*.tar.gz

# DEMs y datos georeferenciados (decenas de MB c/u, descargables con make download-dem)
data/dem/*.tif
data/dem/*.hgt
data/dem/*.zip

# Export PDF/HTML de notebooks (regenerable con make export-notebooks-pdf)
notebooks_resumen.pdf
notebooks_resumen.html

# Notas personales (planificación, ideas, conceptos en estudio)
docs/personal/
docs/paper/

# Referencias bibliográficas (PDFs descargados de papers, binarios grandes)
referencias/

# Doc de planificación inicial (binario grande, raíz del repo)
Simulación Volcánica con CORSIKA y ML.pdf

# Llaves SSH públicas (no son secretas pero identifican; el privado nunca está acá)
*.pub

# Manifest viejo de timings — reemplazado por sim/runs.csv
sim/timings.csv

# Plan de batch personal (cada usuario el suyo). El template versionado
# es sim/runs_plan.example.yaml; copialo como sim/runs_plan.yaml y editalo.
sim/runs_plan.yaml